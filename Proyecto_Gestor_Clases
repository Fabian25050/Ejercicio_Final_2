import json
from datetime import datetime

class Usuario:
    def __init__(self, nombre_usuario, contrasena):
        self.nombre = nombre_usuario
        self.contrasena = contrasena
        self.tareas = []

    def agregar_tarea(self, tarea):
        self.tareas.append(tarea)

    def eliminar_tarea(self, nombre_tarea):
        self.tareas = (tarea for tarea in self.tareas if tarea.nombre_tarea != nombre_tarea)


    def mostrar_tareas(self):
        return self.tareas
        


class Tareas:
    def __init__(self, nombre_tarea, descripcion, fecha_vencimiento):
        self.nombre_tarea = nombre_tarea
        self.descripcion = descripcion
        self.fecha_vencimiento = fecha_vencimiento
        self.completado = False

    def editar_tarea(self, nuevo_nombre, nueva_descripcion, nueva_fv):
        self.nombre_tarea = nuevo_nombre
        self.descripcion = nueva_descripcion
        self.fecha_vencimiento = nueva_fv

    def completar_tarea(self):
        self.completado = True
        



class Gestor:
    def __init__(self, nombre_archivo = "Datos de proyecto.json"):
        self.usuarios = {}
        self.nombre_archivo = nombre_archivo
        self.cargar_datos()


    def cargar_datos(self):
        try:
            with open(self.nombre_archivo, "r") as archivo:
                datos = json.load(archivo)
                for nombre_usuario, datos_usuario in datos.items():
                    usuario = Usuario(nombre_usuario, datos_usuario["contrasena"])
                    for lista_tareas in datos_usuario["tareas"]:
                        tarea = Tareas(lista_tareas["nombre_tarea"], lista_tareas["descripcion"], lista_tareas["fecha_vencimiento"])
                        tarea.completado = lista_tareas["completado"]
                        usuario.agregar_tarea(tarea)
                    self.usuarios[nombre_usuario] = usuario

        except FileNotFoundError:
           print("No se encontro el archivo, se va a crear uno.") 

    def guardar_datos(self):
        
        datos_guardados = {}
        for nombre_usr, datos in self.usuarios.items():
            datos_guardados[nombre_usr] = {
                "contrasena": datos.contrasena,
                "tareas": [{
                    "nombre_tarea": tarea.nombre_tarea,
                    "descripcion": tarea.descripcion,
                    "fecha_vencimiento": tarea.fecha_vencimiento,
                    "completado": tarea.completado
                } for tarea in datos.tareas]
            }
                
        with open(self.nombre_archivo, "w") as archivo:
            json.dump(datos_guardados, archivo)

    def registrar_usuario(self, usuario, contrasena):
        if usuario in self.usuarios:
            print("Este usuario ya esta registrado")
            return False
        
        self.usuarios[usuario] = Usuario(usuario, contrasena)
        self.guardar_datos()
        return True
    
    def iniciar_sesion(self, nombre_usuario, contrasena):
        usuario = self.usuarios.get(nombre_usuario)
        if usuario and usuario.contrasena == contrasena:
            print(f"Bienvenido {usuario.nombre}")
            return usuario
        print("Usuario no registrado")
        return None
    
    def menu_sistema(self, usuario):
        while(True):
            print("Menu de usuario, seleccione una opción:")
            print("1. Crear una tarea")
            print("2. Editar una tarea")
            print("3. Ver tareas")
            print("4. Eliminar una tarea")
            print("5. Completar una tarea")
            print("6. Salir")
            menu_s = input("Introduzca la opción que desee realizar: ")

            if menu_s == "1":
                tarea_titulo = input("Introduzca el título de la tarea: ")
                tarea_descripcion = input("Introduzca la descripción de la tarea: ")
                tarea_fecha_vencimiento = input("Introduzca la fecha de vencimiento de la tarea (DD-MM-AAAA):")
                tarea = Tareas(tarea_titulo, tarea_descripcion, tarea_fecha_vencimiento)
                usuario.agregar_tarea(tarea)
                self.guardar_datos()

            if menu_s == "2":
                tarea_antigua = input("Cual es la tarea que quieres modificar? (título): ")
                tarea = next((t for t in usuario.tareas if t.nombre_tarea == tarea_antigua), None)
                if tarea:
                    tarea_titulo = input("Introduzca el nuevo título de la tarea: ")
                    tarea_descripcion = input("Introduzca la nueva descripción de la tarea: ")
                    tarea_fecha_vencimiento = input("Introduzca la nueva fecha de vencimiento de la tarea (DD-MM-AAAA):")
                    tarea.editar_tarea(tarea_titulo, tarea_descripcion, tarea_fecha_vencimiento)
                    self.guardar_datos()
                else:
                    print("Tareas invalida, regresando a menú de usuario.")


            if menu_s == "3":
                tareas = usuario.mostrar_tareas()
                mostrar_tareas_funcion(tareas)

            if menu_s == "4":
                tarea_eliminar = input("Cual es la tarea que quieres eliminar? (título): ")
                tarea = next((t for t in usuario.tareas if t.nombre_tarea == tarea_eliminar), None)
                if tarea:
                    usuario.eliminar_tarea(tarea_eliminar)
                    self.guardar_datos()

                else:
                    print("Tareas invalida, regresando a menú de usuario.")

            if menu_s == "5":
                tarea_completar = input("Cual es la tarea que quieres completar? (título): ")
                tarea = next((t for t in usuario.tareas if t.nombre_tarea == tarea_completar), None)
                if tarea:
                    tarea.completar_tarea()
                    self.guardar_datos()
                else:
                    print("Tareas invalida, regresando a menú de usuario.")

            if menu_s == "6":
                print("Saliendo de la cuenta de usuario.")
                break

                



def mostrar_tareas_funcion(tareas):
    if tareas:
        print("\n---------------------Tareas del Usuario---------------------")    
        for num, info in enumerate(tareas, start=1):
            estado = "Completado" if info.completado == 1 else "pendiente"
            print(f"{num}. {info.nombre_tarea}: {info.descripcion}, con fecha de vencimiento {info.fecha_vencimiento}, estado: {estado}")
        print("\n------------------------------------------------------------")

    else:
        print("No tienes tareas")






if __name__ == "__main__":
    systema = Gestor()
    while(True):
        print("Este es el sistema gestor de tareas V1.0, eliga una de las opciones para continuar:")
        print("1. Iniciar sesión")
        print("2. Registrarse")
        print("3. Salir")
        menu_p = input("Introduzca la opción de su elección: ")

        if menu_p == "1":
            usuario_m = input("Introduzca su nombre de usuario: ")
            contrasena_m = input("Introduzca su contraseña: ")
            usuario = systema.iniciar_sesion(usuario_m, contrasena_m)
            if usuario:
                systema.menu_sistema(usuario)

        if menu_p == "2":
            usuario_r = input("Para registrarse primero ingrese su nombre de usuario: ")
            contrasena_r = input("Ahora ingrese su contraseña: ")

            systema.registrar_usuario(usuario_r, contrasena_r)


        if menu_p == "3":
            print("Gestor de tareas terminado, que tenga buen día.")
            break
            
        





